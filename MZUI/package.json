{
    "name": "ezmui",
    "version": "1.0.1",
    "description": "A Vue 3 Component Library based on Element Plus",
    "main": "dist/mz-ui.umd.js",
    "module": "dist/mz-ui.es.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/mz-ui.es.js",
            "require": "./dist/mz-ui.umd.js",
            "types": "./dist/types/index.d.ts"
        },
        "./dist/style.css": "./dist/style.css"
    },
    "files": [
        "dist",
        "README.md",
        "PUBLISH.md",
        "DEVELOPMENT.md"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:check": "vue-tsc && vite build",
        "preview": "vite preview",
        "prepublishOnly": "npm run build",
        "pack:check": "npm pack --dry-run",
        "version:patch": "npm version patch",
        "version:minor": "npm version minor",
        "version:major": "npm version major"
    },
    "keywords": [
        "vue",
        "vue3",
        "component",
        "ui",
        "element-plus",
        "mz-ui",
        "frontend",
        "components",
        "library"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/marcoolTang/mz-ui.git"
    },
    "bugs": {
        "url": "https://github.com/marcoolTang/mz-ui/issues"
    },
    "homepage": "https://github.com/marcoolTang/mz-ui/blob/master/README.md",
    "author": "Marco Tang<tzzwpqwe@vip.qq.com>",
    "license": "MIT",
    "peerDependencies": {
        "element-plus": "^2.4.0",
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@vitejs/plugin-vue": "^4.5.0",
        "element-plus": "^2.4.4",
        "pinia": "^3.0.4",
        "sass": "^1.69.5",
        "typescript": "^5.3.3",
        "vite": "^5.0.0",
        "vue": "^3.3.11",
        "vue-router": "^4.6.3",
        "vue-tsc": "^1.8.27"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "js-file-download": "^0.4.12",
        "js-md5": "^0.8.3",
        "vue-to-print": "^1.5.1"
    }
}
